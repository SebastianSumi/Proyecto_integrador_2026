-- =====================================================
-- TABLA: ALERTA_CLINICA
-- Tabla principal de alertas clínicas generadas
-- =====================================================
CREATE TABLE ALERTA_CLINICA (
    ID_ALERTA RAW(16) DEFAULT SYS_GUID() NOT NULL,
    ID_PERSONA NUMBER(10) NOT NULL,
    NOMBRE_PACIENTE VARCHAR2(150),
    ID_EVALUACION_ORIGEN NUMBER(19),
    NIVEL_SEVERIDAD VARCHAR2(20) NOT NULL,
    SCORE_RIESGO NUMBER(10),
    ESTADO VARCHAR2(20) NOT NULL,
    SNAPSHOT_INMUTABLE CLOB,
    FECHA_GENERACION TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,
    FECHA_VENCIMIENTO_SLA TIMESTAMP,
    VERSION NUMBER(19) DEFAULT 0,
    CONSTRAINT PK_ALERTA_CLINICA PRIMARY KEY (ID_ALERTA),
    CONSTRAINT CK_ALERTA_SEVERIDAD CHECK (NIVEL_SEVERIDAD IN (
        'LEVE', 'MODERADO', 'CRITICO')),
    CONSTRAINT CK_ALERTA_ESTADO CHECK (ESTADO IN (
        'PENDIENTE', 'EN_REVISION', 'ATENDIDA', 'DESESTIMADA', 'VENCIDO', 'ANULADA'))
);

CREATE INDEX IDX_ALERTA_PERSONA ON ALERTA_CLINICA(ID_PERSONA);
CREATE INDEX IDX_ALERTA_ESTADO ON ALERTA_CLINICA(ESTADO);
CREATE INDEX IDX_ALERTA_SEVERIDAD ON ALERTA_CLINICA(NIVEL_SEVERIDAD);
CREATE INDEX IDX_ALERTA_FECHA ON ALERTA_CLINICA(FECHA_GENERACION);
CREATE INDEX IDX_ALERTA_EVALUACION ON ALERTA_CLINICA(ID_EVALUACION_ORIGEN);
CREATE INDEX IDX_ALERTA_SLA ON ALERTA_CLINICA(FECHA_VENCIMIENTO_SLA);

-- =====================================================
-- TABLA: ALERTA_CLINICA_DETALLE
-- Indicadores individuales que componen cada alerta
-- =====================================================
CREATE TABLE ALERTA_CLINICA_DETALLE (
    ID_DETALLE RAW(16) DEFAULT SYS_GUID() NOT NULL,
    ID_ALERTA RAW(16) NOT NULL,
    TIPO_INDICADOR VARCHAR2(40) NOT NULL,
    VALOR_MEDIDO NUMBER(10,2) NOT NULL,
    LIMITE_REFERENCIA NUMBER(10,2) NOT NULL,
    PORCENTAJE_DESVIACION NUMBER(5,2),
    MULTIPLICADOR_REINCIDENCIA NUMBER(3,1) DEFAULT 1.0,
    CONSTRAINT PK_ALERTA_DETALLE PRIMARY KEY (ID_DETALLE),
    CONSTRAINT FK_DETALLE_ALERTA FOREIGN KEY (ID_ALERTA)
        REFERENCES ALERTA_CLINICA(ID_ALERTA),
    CONSTRAINT CK_DETALLE_INDICADOR CHECK (TIPO_INDICADOR IN (
        'IMC', 'GRASA_VISCERAL', 'GLUCOSA', 'COLESTEROL_TOTAL',
        'COLESTEROL_HDL', 'COLESTEROL_LDL', 'TRIGLICERIDOS',
        'PRESION_SISTOLICA', 'PRESION_DIASTOLICA',
        'RIESGO_METABOLICO', 'RIESGO_CARDIOVASCULAR'))
);

CREATE INDEX IDX_DETALLE_ALERTA ON ALERTA_CLINICA_DETALLE(ID_ALERTA);
CREATE INDEX IDX_DETALLE_INDICADOR ON ALERTA_CLINICA_DETALLE(TIPO_INDICADOR);

-- =====================================================
-- TABLA: RESOLUCION_CLINICA
-- Registro de atención/resolución de cada alerta
-- =====================================================
CREATE TABLE RESOLUCION_CLINICA (
    ID_RESOLUCION RAW(16) DEFAULT SYS_GUID() NOT NULL,
    ID_ALERTA RAW(16) NOT NULL,
    ID_USUARIO_EVALUADOR NUMBER(19) NOT NULL,
    NOMBRE_EVALUADOR VARCHAR2(150),
    ID_ACCION_CORRECTIVA NUMBER(19),
    MOTIVO_DESESTIMACION VARCHAR2(100),
    OBSERVACIONES_CLINICAS CLOB,
    FECHA_ATENCION TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,
    ES_SEGUIMIENTO_PROGRAMADO NUMBER(1) DEFAULT 0,
    FECHA_SEGUIMIENTO_PROGRAMADO TIMESTAMP,
    DIAS_SEGUIMIENTO NUMBER(5),
    CONSTRAINT PK_RESOLUCION_CLINICA PRIMARY KEY (ID_RESOLUCION),
    CONSTRAINT UK_RESOLUCION_ALERTA UNIQUE (ID_ALERTA),
    CONSTRAINT FK_RESOLUCION_ALERTA FOREIGN KEY (ID_ALERTA)
        REFERENCES ALERTA_CLINICA(ID_ALERTA),
    CONSTRAINT FK_RESOLUCION_ACCION FOREIGN KEY (ID_ACCION_CORRECTIVA)
        REFERENCES CATALOGO_ACCION_CORRECTIVA(ID_ACCION)
);

CREATE INDEX IDX_RESOLUCION_EVALUADOR ON RESOLUCION_CLINICA(ID_USUARIO_EVALUADOR);
CREATE INDEX IDX_RESOLUCION_ACCION ON RESOLUCION_CLINICA(ID_ACCION_CORRECTIVA);
CREATE INDEX IDX_RESOLUCION_FECHA ON RESOLUCION_CLINICA(FECHA_ATENCION);
CREATE INDEX IDX_RESOLUCION_SEGUIMIENTO ON RESOLUCION_CLINICA(FECHA_SEGUIMIENTO_PROGRAMADO);

COMMIT;
EXIT
