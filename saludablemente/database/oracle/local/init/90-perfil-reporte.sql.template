WHENEVER SQLERROR EXIT SQL.SQLCODE

-- =====================================================
-- MODULO: PERFIL / REPORTE PERSONALIZADO
-- Esquema: SALUD_PERFIL_REPORTE
-- Sin FK a PERSONA (aislamiento de modulos - BOM ERP)
-- =====================================================

-- =====================================================
-- TABLA: REPORTE_PERSONAL
-- =====================================================
CREATE TABLE REPORTE_PERSONAL (
    ID_REPORTE RAW(16) DEFAULT SYS_GUID() PRIMARY KEY,
    ID_PERSONA NUMBER(10) NOT NULL,
    NOMBRE_COLABORADOR VARCHAR2(150),
    PERIODO_SEMESTRAL VARCHAR2(10) NOT NULL,
    VERSION_REPORTE NUMBER(5) DEFAULT 1 NOT NULL,
    SNAPSHOT_DATOS CLOB NOT NULL,
    RUTA_ALMACENAMIENTO VARCHAR2(300) NOT NULL,
    TIPO_ALMACENAMIENTO VARCHAR2(20) DEFAULT 'LOCAL' NOT NULL,
    TAMANO_BYTES NUMBER(19) NOT NULL,
    HASH_INTEGRIDAD_SHA256 VARCHAR2(64) NOT NULL,
    ESTADO_GENERACION VARCHAR2(20) DEFAULT 'COMPLETADO' NOT NULL,
    FECHA_GENERACION TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,
    GENERADO_POR VARCHAR2(80) NOT NULL,
    VIGENTE NUMBER(1) DEFAULT 1,
    CONSTRAINT CK_REPORTE_TIPO_ALMACENAMIENTO
        CHECK (TIPO_ALMACENAMIENTO IN ('LOCAL', 'S3')),
    CONSTRAINT CK_REPORTE_ESTADO_GENERACION
        CHECK (ESTADO_GENERACION IN ('PENDIENTE', 'COMPLETADO', 'ERROR_GENERACION'))
);

CREATE INDEX IDX_REPORTE_PERSONA_PERIODO
    ON REPORTE_PERSONAL(ID_PERSONA, PERIODO_SEMESTRAL);
CREATE INDEX IDX_REPORTE_HASH
    ON REPORTE_PERSONAL(HASH_INTEGRIDAD_SHA256);
CREATE INDEX IDX_REPORTE_FECHA_GENERACION
    ON REPORTE_PERSONAL(FECHA_GENERACION);
CREATE INDEX IDX_REPORTE_VIGENTE
    ON REPORTE_PERSONAL(VIGENTE);

-- =====================================================
-- TABLA: REPORTE_DESCARGA_BITACORA
-- FK interna hacia REPORTE_PERSONAL (mismo modulo)
-- =====================================================
CREATE TABLE REPORTE_DESCARGA_BITACORA (
    ID_DESCARGA RAW(16) DEFAULT SYS_GUID() PRIMARY KEY,
    ID_REPORTE RAW(16) NOT NULL,
    ID_PERSONA_SOLICITANTE NUMBER(10) NOT NULL,
    DIRECCION_IP VARCHAR2(45) NOT NULL,
    USER_AGENT VARCHAR2(255),
    FECHA_DESCARGA TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,
    CONSTRAINT FK_DESCARGA_REPORTE FOREIGN KEY (ID_REPORTE)
        REFERENCES REPORTE_PERSONAL(ID_REPORTE)
);

CREATE INDEX IDX_DESCARGA_REPORTE
    ON REPORTE_DESCARGA_BITACORA(ID_REPORTE);
CREATE INDEX IDX_DESCARGA_FECHA
    ON REPORTE_DESCARGA_BITACORA(FECHA_DESCARGA);

-- =====================================================
-- TABLA: COLA_GENERACION_REPORTES
-- Sin FK a PERSONA
-- =====================================================
CREATE TABLE COLA_GENERACION_REPORTES (
    ID_TAREA RAW(16) DEFAULT SYS_GUID() PRIMARY KEY,
    ID_PERSONA NUMBER(10) NOT NULL,
    PERIODO_SEMESTRAL VARCHAR2(10) NOT NULL,
    FORZAR_REGENERACION NUMBER(1) DEFAULT 0,
    INTENTOS_ACUMULADOS NUMBER(5) DEFAULT 0,
    ESTADO_COLA VARCHAR2(20) DEFAULT 'EN_COLA',
    ULTIMO_ERROR CLOB,
    FECHA_SOLICITUD TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,
    FECHA_ULTIMA_ACTUALIZACION TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,
    CONSTRAINT CK_COLA_ESTADO
        CHECK (ESTADO_COLA IN ('EN_COLA', 'PROCESANDO', 'FALLIDO', 'COMPLETADO'))
);

CREATE INDEX IDX_COLA_ESTADO
    ON COLA_GENERACION_REPORTES(ESTADO_COLA);
CREATE INDEX IDX_COLA_PERSONA_PERIODO
    ON COLA_GENERACION_REPORTES(ID_PERSONA, PERIODO_SEMESTRAL);
CREATE INDEX IDX_COLA_FECHA_SOLICITUD
    ON COLA_GENERACION_REPORTES(FECHA_SOLICITUD);

COMMIT;
EXIT
