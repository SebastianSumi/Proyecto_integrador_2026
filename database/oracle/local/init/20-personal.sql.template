WHENEVER SQLERROR EXIT SQL.SQLCODE
CREATE TABLE PERSONA (ID_PERSONA NUMBER(19) GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, NOMBRES VARCHAR2(100 CHAR) NOT NULL, APELLIDO_PATERNO VARCHAR2(100 CHAR) NOT NULL, APELLIDO_MATERNO VARCHAR2(100 CHAR) NOT NULL, CELULAR VARCHAR2(15 CHAR) NOT NULL UNIQUE, FECHA_NACIMIENTO DATE NOT NULL, SEXO VARCHAR2(10 CHAR) NOT NULL, TALLA_POLO VARCHAR2(10 CHAR), ID_TEAM NUMBER(19), ACTIVO BOOLEAN NOT NULL);
CREATE TABLE PREFERENCIA_COMUNICACION (ID_PREFERENCIA NUMBER(19) GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, CANAL_PREFERIDO VARCHAR2(50 CHAR) NOT NULL, HORARIO_CONTACTO_INICIO TIMESTAMP(6), HORARIO_CONTACTO_FIN TIMESTAMP(6), ACEPTA_RECORDATORIOS BOOLEAN NOT NULL, ID_PERSONA NUMBER(19) NOT NULL UNIQUE, CONSTRAINT FK_PREF_PERSONA FOREIGN KEY (ID_PERSONA) REFERENCES PERSONA(ID_PERSONA));
CREATE TABLE CREDENCIAL_PROGRAMA (ID_CREDENCIAL NUMBER(19) GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, CODIGO_QR_HASH VARCHAR2(255 CHAR) NOT NULL UNIQUE, TIPO_CREDENCIAL VARCHAR2(50 CHAR) NOT NULL, FECHA_EMISION TIMESTAMP(6) NOT NULL, ESTADO VARCHAR2(20 CHAR) NOT NULL, ID_PERSONA NUMBER(19) NOT NULL, CONSTRAINT FK_CRED_PERSONA FOREIGN KEY (ID_PERSONA) REFERENCES PERSONA(ID_PERSONA));
EXIT
