CREATE TABLE EVALUACION_NUTRICIONAL (ID_EVALUACION NUMBER(19) GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, ID_PERSONA NUMBER(19) NOT NULL, FECHA_EVALUACION DATE NOT NULL, PERIODO_SEMESTRAL VARCHAR2(20 CHAR) NOT NULL, ESTADO_EVALUACION VARCHAR2(30 CHAR) NOT NULL, OBSERVACIONES CLOB);
CREATE TABLE DETALLE_ANTROPOMETRICO (ID_ANTROPOMETRICO NUMBER(19) GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, ESTATURA_CM NUMBER(5,2) NOT NULL, PESO_KG NUMBER(5,2) NOT NULL, PERIMETRO_ABDOMINAL_CM NUMBER(5,2), IMC NUMBER(4,2) NOT NULL, PORCENTAJE_GRASA NUMBER(4,2), PORCENTAJE_MASA_MUSCULAR NUMBER(4,2), PORCENTAJE_GRASA_VISCERAL NUMBER(4,2), DX_IMC VARCHAR2(50 CHAR), DX_PERIMETRO_ABDOMINAL VARCHAR2(50 CHAR), DX_GRASA VARCHAR2(50 CHAR), DX_MASA_MUSCULAR VARCHAR2(50 CHAR), DX_GRASA_VISCERAL VARCHAR2(50 CHAR), ID_EVALUACION NUMBER(19) NOT NULL UNIQUE, CONSTRAINT FK_ANTRO_EVAL FOREIGN KEY (ID_EVALUACION) REFERENCES EVALUACION_NUTRICIONAL(ID_EVALUACION));
CREATE TABLE DETALLE_BIOQUIMICO (ID_BIOQUIMICO NUMBER(19) GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, GLUCOSA NUMBER(5,2), COLESTEROL NUMBER(5,2), TRIGLICERIDOS NUMBER(5,2), PRESION_SISTOLICA NUMBER(10), PRESION_DIASTOLICA NUMBER(10), DX_BIOQUIMICO VARCHAR2(100 CHAR), ARCHIVO_ORIGEN VARCHAR2(255 CHAR), FECHA_IMPORTACION TIMESTAMP(6), ID_USUARIO_IMPORTADOR NUMBER(19), ID_EVALUACION NUMBER(19) UNIQUE, CONSTRAINT FK_BIO_EVAL FOREIGN KEY (ID_EVALUACION) REFERENCES EVALUACION_NUTRICIONAL(ID_EVALUACION));
