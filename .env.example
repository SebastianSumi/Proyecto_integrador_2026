# Copy to .env.local and replace every password locally. Never commit .env.local.
ORACLE_PORT=1522
ORACLE_PASSWORD=replace_with_a_local_sys_password
DB_USERNAME=SALUDABLEMENTE_APP
DB_PASSWORD=replace_with_a_local_runtime_password
LOCAL_ORACLE_OWNER_PASSWORD=replace_with_a_local_owner_password

# Used by Spring profile local-oracle.
DB_URL=jdbc:oracle:thin:@localhost:1522/FREEPDB1
