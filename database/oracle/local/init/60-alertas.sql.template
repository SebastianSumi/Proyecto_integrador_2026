-- =====================================================
-- SECUENCIA para CATALOGO_ACCION_CORRECTIVA
-- =====================================================
CREATE SEQUENCE SEQ_ACCION_CORRECTIVA
    START WITH 1
    INCREMENT BY 1
    NOCACHE
    NOCYCLE;

-- =====================================================
-- TABLA: CATALOGO_ACCION_CORRECTIVA
-- Catalogo maestro de acciones correctivas tipificadas
-- =====================================================
CREATE TABLE CATALOGO_ACCION_CORRECTIVA (
    ID_ACCION NUMBER(19) DEFAULT SEQ_ACCION_CORRECTIVA.NEXTVAL NOT NULL,
    CODIGO_TIPIFICADO VARCHAR2(40) NOT NULL,
    DESCRIPCION VARCHAR2(150) NOT NULL,
    REQUIERE_SEGUIMIENTO VARCHAR2(1) DEFAULT 'N',
    DIAS_SEGUIMIENTO NUMBER(5),
    CONSTRAINT PK_CATALOGO_ACCION PRIMARY KEY (ID_ACCION),
    CONSTRAINT UK_CATALOGO_CODIGO UNIQUE (CODIGO_TIPIFICADO),
    CONSTRAINT CK_CATALOGO_SEGUIMIENTO CHECK (REQUIERE_SEGUIMIENTO IN ('S', 'N'))
);

