WHENEVER SQLERROR EXIT SQL.SQLCODE
CREATE TABLE CATALOGO_PRUEBA (ID_PRUEBA NUMBER(19) GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, NOMBRE_PRUEBA VARCHAR2(100 CHAR) NOT NULL, UNIDAD_MEDIDA VARCHAR2(30 CHAR) NOT NULL, DESCRIPCION CLOB, ACTIVO NUMBER(1) NOT NULL);
CREATE TABLE EVALUACION_APTITUD (ID_EVALUACION_APTITUD NUMBER(19) GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, ID_PERSONA NUMBER(19) NOT NULL, FECHA_REGISTRO DATE NOT NULL, PUNTAJE_GLOBAL NUMBER(5,2) NOT NULL, DIAGNOSTICO_APTITUD VARCHAR2(50 CHAR) NOT NULL, SINCRONIZADO NUMBER(1) NOT NULL, FECHA_SINCRONIZACION TIMESTAMP(6));
CREATE TABLE DETALLE_PRUEBA_FISICA (ID_DETALLE_APTITUD NUMBER(19) GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, VALOR_OBTENIDO NUMBER(6,2) NOT NULL, PUNTAJE_PARCIAL NUMBER(5,2) NOT NULL, ID_EVALUACION_APTITUD NUMBER(19) NOT NULL, ID_PRUEBA NUMBER(19) NOT NULL, CONSTRAINT FK_DET_EVALUACION FOREIGN KEY (ID_EVALUACION_APTITUD) REFERENCES EVALUACION_APTITUD(ID_EVALUACION_APTITUD), CONSTRAINT FK_DET_PRUEBA FOREIGN KEY (ID_PRUEBA) REFERENCES CATALOGO_PRUEBA(ID_PRUEBA));
MERGE INTO CATALOGO_PRUEBA c USING (SELECT 'SALTO_VERTICAL' nombre_prueba, 'CM' unidad_medida FROM dual) s ON (c.NOMBRE_PRUEBA=s.nombre_prueba) WHEN NOT MATCHED THEN INSERT (NOMBRE_PRUEBA,UNIDAD_MEDIDA,ACTIVO) VALUES (s.nombre_prueba,s.unidad_medida,1);
EXIT
