WHENEVER SQLERROR EXIT SQL.SQLCODE
CREATE TABLE ACTIVIDADES (ID NUMBER(19) GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, NOMBRE VARCHAR2(100 CHAR) NOT NULL, FECHA DATE NOT NULL, HORA_INICIO TIMESTAMP(6) NOT NULL, HORA_FIN TIMESTAMP(6) NOT NULL, LUGAR VARCHAR2(100 CHAR) NOT NULL, ESTADO VARCHAR2(20 CHAR) NOT NULL, CREADOR_ID NUMBER(19) NOT NULL);
CREATE TABLE INSCRIPCIONES (ID NUMBER(19) GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, ACTIVIDAD_ID NUMBER(19) NOT NULL, PERSONA_ID NUMBER(19) NOT NULL, ESTADO VARCHAR2(20 CHAR) NOT NULL, INSCRITA_EN TIMESTAMP(6) NOT NULL, CANCELADA_EN TIMESTAMP(6), CONSTRAINT FK_INSCRIPCION_ACTIVIDAD FOREIGN KEY (ACTIVIDAD_ID) REFERENCES ACTIVIDADES(ID));
CREATE TABLE METAS (ID NUMBER(19) GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, PERSONA_ID NUMBER(19) NOT NULL, TIPO_META VARCHAR2(40 CHAR) NOT NULL, DESCRIPCION VARCHAR2(200 CHAR), VALOR_OBJETIVO NUMBER(6,2) NOT NULL, VALOR_ACTUAL NUMBER(6,2), FECHA_INICIO DATE NOT NULL, FECHA_LIMITE DATE NOT NULL, ESTADO VARCHAR2(20 CHAR) NOT NULL);
CREATE TABLE TEAMS (ID NUMBER(19) GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, NAME VARCHAR2(60 CHAR) NOT NULL, DESCRIPTION VARCHAR2(200 CHAR), ACTIVE BOOLEAN NOT NULL);
EXIT
