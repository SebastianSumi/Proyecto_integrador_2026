WHENEVER SQLERROR EXIT SQL.SQLCODE
CREATE TABLE ASISTENCIAS (ID NUMBER(19) GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, ID_ACTIVIDAD NUMBER(19) NOT NULL, ID_PERSONA NUMBER(19) NOT NULL, FECHA_HORA_MARCADO TIMESTAMP(6) NOT NULL, METODO VARCHAR2(30 CHAR) NOT NULL, ESTADO VARCHAR2(20 CHAR) NOT NULL, ES_OFFLINE BOOLEAN NOT NULL, DISPOSITIVO_UUID VARCHAR2(100 CHAR), CONSTRAINT UK_ASISTENCIA UNIQUE (ID_ACTIVIDAD, ID_PERSONA));
CREATE TABLE NOTICIAS (ID_NOTICIA NUMBER(19) GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, TITULO VARCHAR2(150 CHAR) NOT NULL, CONTENIDO CLOB NOT NULL, IMAGEN_URL VARCHAR2(250 CHAR), FECHA_PUBLICACION TIMESTAMP(6), ESTADO VARCHAR2(20 CHAR) NOT NULL, ID_USUARIO_AUTOR NUMBER(19) NOT NULL);
CREATE TABLE NOTIFICACIONES (ID_NOTIFICACION NUMBER(19) GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, ID_PERSONA NUMBER(19) NOT NULL, TITULO VARCHAR2(100 CHAR) NOT NULL, MENSAJE CLOB NOT NULL, MODULO_ORIGEN VARCHAR2(50 CHAR) NOT NULL, REFERENCIA_ID NUMBER(19), LEIDO NUMBER(1) NOT NULL, FECHA_ENVIO TIMESTAMP(6) NOT NULL);
EXIT
