WHENEVER SQLERROR EXIT SQL.SQLCODE

-- =====================================================
-- MODULO: RECOMENDACIONES IA
-- Esquema: SALUD_RECOMENDACIONES_IA
-- Sin FK a PERSONA (aislamiento de modulos - BOM ERP)
-- =====================================================

-- =====================================================
-- TABLA: RECOMENDACION_IA
-- Recomendaciones generadas por IA para cada colaborador
-- =====================================================
CREATE TABLE RECOMENDACION_IA (
    ID_RECOMENDACION RAW(16) DEFAULT SYS_GUID() NOT NULL,
    ID_PERSONA NUMBER(10) NOT NULL,
    ID_EVALUACION NUMBER(19),
    MODELO_IA_USADO VARCHAR2(60),
    PROMPT_CONTEXTO CLOB,
    SCORE_CONFIANZA_IA NUMBER(10),
    VIGENTE NUMBER(1) DEFAULT 1,
    ESTADO_INFERENCIA VARCHAR2(30),
    FECHA_GENERACION TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,
    FECHA_LECTURA_COLABORADOR TIMESTAMP,
    LEIDA NUMBER(1) DEFAULT 0,
    TIEMPO_INFERENCIA_MS NUMBER(10),
    CONSTRAINT PK_RECOMENDACION_IA PRIMARY KEY (ID_RECOMENDACION),
    CONSTRAINT CK_RECOMENDACION_ESTADO CHECK (ESTADO_INFERENCIA IN (
        'EXITOSA', 'FALLBACK_APLICADO', 'FALLO_DEFINITIVO', 'PENDIENTE_REINTENTO'))
);

CREATE INDEX IDX_RECOMENDACION_PERSONA ON RECOMENDACION_IA(ID_PERSONA);
CREATE INDEX IDX_RECOMENDACION_EVALUACION ON RECOMENDACION_IA(ID_EVALUACION);
CREATE INDEX IDX_RECOMENDACION_VIGENTE ON RECOMENDACION_IA(VIGENTE);
CREATE INDEX IDX_RECOMENDACION_ESTADO ON RECOMENDACION_IA(ESTADO_INFERENCIA);
CREATE INDEX IDX_RECOMENDACION_FECHA ON RECOMENDACION_IA(FECHA_GENERACION);
CREATE INDEX IDX_RECOMENDACION_LEIDA ON RECOMENDACION_IA(LEIDA);

-- =====================================================
-- TABLA: RECOMENDACION_IA_DETALLE
-- Secciones individuales de cada recomendación (ejercicio, nutricion)
-- =====================================================
CREATE TABLE RECOMENDACION_IA_DETALLE (
    ID_DETALLE RAW(16) DEFAULT SYS_GUID() NOT NULL,
    ID_RECOMENDACION RAW(16) NOT NULL,
    TIPO_SECCION VARCHAR2(20) NOT NULL,
    CONTENIDO_ESTRUCTURADO CLOB,
    CONTRADICCIONES CLOB,
    CONSTRAINT PK_RECOMENDACION_DETALLE PRIMARY KEY (ID_DETALLE),
    CONSTRAINT FK_DETALLE_RECOMENDACION FOREIGN KEY (ID_RECOMENDACION)
        REFERENCES RECOMENDACION_IA(ID_RECOMENDACION),
    CONSTRAINT CK_DETALLE_SECCION CHECK (TIPO_SECCION IN (
        'EJERCICIO', 'NUTRICION'))
);

CREATE INDEX IDX_REC_DETALLE_RECOMENDACION ON RECOMENDACION_IA_DETALLE(ID_RECOMENDACION);
CREATE INDEX IDX_REC_DETALLE_SECCION ON RECOMENDACION_IA_DETALLE(TIPO_SECCION);

COMMIT;
EXIT
